{
  "name": "dsh-mobile-bridge",
  "version": "0.4.15",
  "private": false,
  "type": "module",
  "description": "DeepSeek Harness mobile bridge: LAN pairing with QR codes, a cookie-isolated proxy of the desktop GUI, APK download page and turn-end notification stream for phones.",
  "license": "MIT",
  "author": "Kattentions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kattentions/dsh-mobile-bridge.git"
  },
  "homepage": "https://github.com/Kattentions/dsh-mobile-bridge#readme",
  "bugs": {
    "url": "https://github.com/Kattentions/dsh-mobile-bridge/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "remote",
    "lan",
    "pairing",
    "qr"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "vendor/**",
    "public/**",
    "docs/**",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "scripts/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check-endpoints.mjs && node scripts/check-app.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepare-release": "node scripts/prepare-release.mjs",
    "probe:devices": "node scripts/probe-devices.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js"
}
